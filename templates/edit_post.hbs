{{#* inline "inside"}}
<form id="post-editor" action="{{#if post}}/post/{{post.slug}}/edit{{else}}/posts/new{{/if}}" method="post">
    <input class="title" type="text" name="title" placeholder="Post title" value="{{post.title}}">
    <textarea type="text" name="body" placeholder="Post contents">{{{post.body}}}</textarea>
    <input class="submit" type="submit" value="Submit">
</form>
{{/inline}}
{{> base}}
