<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>wyrite</title>
</head>
<body>
    <h1>Post Index</h1>
    <ul>
        {{#each posts}}
        <li><code>[{{ uuid }}]</code> <a href="/post/{{slug}}">{{ title }}</a></li>
        {{/each}}
    </ul>
</body>
</html>
